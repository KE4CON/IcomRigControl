<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IcomRigControl.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="360"
        x:Class="IcomRigControl.UI.Views.RemoteAudioWindow"
        x:DataType="vm:RemoteAudioViewModel"
        Title="Remote Audio"
        Width="520" Height="360"
        Background="#1a1a1a">

    <StackPanel Margin="16" Spacing="12">

        <TextBlock Text="Live audio to/from the radio over the network (Phase 12). The server host is the same machine running --headless-server. RX audio always plays; the mic streams only while Transmit is held."
                   Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>

        <Border Background="#0d0d0d" CornerRadius="6" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="Server host" Foreground="Gray" FontSize="11"/>
                <TextBox Text="{Binding ServerHost}" Watermark="44.x.x.x or hostname"/>
                <TextBlock Text="Audio UDP port" Foreground="Gray" FontSize="11"/>
                <NumericUpDown Value="{Binding AudioPort}" Minimum="1" Maximum="65535"/>
                <TextBlock Text="Microphone (for transmit)" Foreground="Gray" FontSize="11"/>
                <ComboBox ItemsSource="{Binding CaptureDevices}" SelectedItem="{Binding SelectedCaptureDevice}"
                          HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Content="Connect" Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding !IsConnected}"
                            Background="#2a2a2a" Foreground="White" Padding="12,6">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#00ff88"/>
                                <Setter Property="TextBlock.Foreground" Value="Black"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                            IsEnabled="{Binding IsConnected}"
                            Background="#5a2a2a" Foreground="White" Padding="12,6">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Red"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <ToggleButton Content="{Binding IsTransmitting, Converter={x:Static vm:TransmitButtonTextConverter.Instance}}"
                      IsChecked="{Binding IsTransmitting}"
                      IsEnabled="{Binding IsConnected}"
                      HorizontalAlignment="Stretch" Height="44"
                      Background="#2a2a2a" Foreground="White" FontWeight="Bold">
            <ToggleButton.Styles>
                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                    <Setter Property="Background" Value="Red"/>
                    <Setter Property="TextBlock.Foreground" Value="White"/>
                </Style>
                <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#3a3a3a"/>
                    <Setter Property="TextBlock.Foreground" Value="White"/>
                </Style>
                <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#cc0000"/>
                    <Setter Property="TextBlock.Foreground" Value="White"/>
                </Style>
            </ToggleButton.Styles>
        </ToggleButton>

        <TextBlock Text="{Binding Status}" Foreground="#00ff88" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
