<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IcomRigControl.UI.ViewModels"
        xmlns:views="using:IcomRigControl.UI.Views"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="360"
        x:Class="IcomRigControl.UI.Views.BandDvrWindow"
        x:DataType="vm:BandDvrViewModel"
        Title="Band DVR"
        Width="580" Height="700"
        Background="#1a1a1a">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="16">

        <TextBlock Grid.Row="0" Text="Record and rewind the radio. Monitor keeps the last 60 seconds ready to replay."
                   Foreground="#88ccff" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="Start Monitor" Command="{Binding StartMonitorCommand}" IsEnabled="{Binding !IsMonitoring}"
                    Background="#2a2a2a" Foreground="White" Padding="12,6">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#00ff88"/><Setter Property="TextBlock.Foreground" Value="Black"/>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Content="Stop" Command="{Binding StopMonitorCommand}" IsEnabled="{Binding IsMonitoring}"
                    Background="#5a2a2a" Foreground="White" Padding="12,6">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Red"/><Setter Property="TextBlock.Foreground" Value="White"/>
                    </Style>
                </Button.Styles>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="⏪ Replay last 30s" Command="{Binding ReplayLast30Command}" IsEnabled="{Binding IsMonitoring}"
                    Background="#243b5a" Foreground="White" Padding="12,8"/>
            <Button Content="⏪ Replay last 60s" Command="{Binding ReplayLast60Command}" IsEnabled="{Binding IsMonitoring}"
                    Background="#243b5a" Foreground="White" Padding="12,8"/>
            <Button Content="📈 Replay waterfall" Command="{Binding ReplayWaterfallCommand}"
                    Background="#243b5a" Foreground="White" Padding="12,8"
                    ToolTip.Tip="Redraw the last ~90 seconds of the waterfall (in memory — no disk used)."/>
        </StackPanel>

        <Border Grid.Row="3" Background="#000" CornerRadius="6" Height="130" Margin="0,0,0,10">
            <views:WaterfallControl x:Name="ReplayWaterfall"/>
        </Border>

        <Border Grid.Row="4" Background="#0d0d0d" CornerRadius="6" Padding="12">
            <StackPanel Spacing="8">
                <ToggleButton IsChecked="{Binding IsRecording}"
                              IsEnabled="{Binding IsMonitoring}" HorizontalAlignment="Left">
                    <ToggleButton.Styles>
                        <Style Selector="ToggleButton">
                            <Setter Property="Background" Value="#2a2a2a"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,8"/>
                        </Style>
                        <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                            <Setter Property="Background" Value="Red"/><Setter Property="TextBlock.Foreground" Value="White"/>
                        </Style>
                        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#3a3a3a"/>
                        </Style>
                        <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#ff5555"/><Setter Property="TextBlock.Foreground" Value="White"/>
                        </Style>
                    </ToggleButton.Styles>
                    <TextBlock Text="⏺ Record to file"/>
                </ToggleButton>
                <TextBlock Text="Recordings are WAV files at 11 kHz (~1.3 MB/min) in Documents → IcomRigControl. Per-QSO clips save automatically while monitoring."
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Recordings manager -->
        <Border Grid.Row="5" Background="#0d0d0d" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                    <TextBlock Text="Recordings" Foreground="#88ccff" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalSize}" Foreground="Gray" VerticalAlignment="Center"/>
                    <Button Content="Refresh" Command="{Binding RefreshRecordingsCommand}"
                            Background="#2a2a2a" Foreground="White" Padding="8,4"/>
                    <Button Content="Open folder" Command="{Binding OpenRecordingsFolderCommand}"
                            Background="#2a2a2a" Foreground="White" Padding="8,4"/>
                    <Button Content="Delete all" Command="{Binding DeleteAllRecordingsCommand}"
                            Background="#5a2a2a" Foreground="White" Padding="8,4"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Recordings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,80,60,60" Margin="0,0,0,2" Background="#141414">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#e0e0e0"
                                               FontFamily="Courier New" FontSize="12" Padding="6,5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="Gray" Padding="4,5"/>
                                    <Button Grid.Column="2" Content="Play" Margin="2"
                                            Command="{Binding $parent[ItemsControl].((vm:BandDvrViewModel)DataContext).PlayRecordingCommand}"
                                            CommandParameter="{Binding}" Background="#2a2a2a" Foreground="White"/>
                                    <Button Grid.Column="3" Content="Del" Margin="2"
                                            Command="{Binding $parent[ItemsControl].((vm:BandDvrViewModel)DataContext).DeleteRecordingCommand}"
                                            CommandParameter="{Binding}" Background="#5a2a2a" Foreground="White"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6" Text="{Binding Status}" Foreground="#00ff88" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>
