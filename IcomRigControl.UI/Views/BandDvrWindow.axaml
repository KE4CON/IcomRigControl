<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IcomRigControl.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="360"
        x:Class="IcomRigControl.UI.Views.BandDvrWindow"
        x:DataType="vm:BandDvrViewModel"
        Title="Band DVR"
        Width="520" Height="360"
        Background="#1a1a1a">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">

        <TextBlock Grid.Row="0" Text="Record and rewind the radio. Monitor keeps the last 60 seconds ready to replay."
                   Foreground="#88ccff" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="Start Monitor" Command="{Binding StartMonitorCommand}" IsEnabled="{Binding !IsMonitoring}"
                    Background="#2a2a2a" Foreground="White" Padding="12,6">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#00ff88"/><Setter Property="TextBlock.Foreground" Value="Black"/>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Content="Stop" Command="{Binding StopMonitorCommand}" IsEnabled="{Binding IsMonitoring}"
                    Background="#5a2a2a" Foreground="White" Padding="12,6">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Red"/><Setter Property="TextBlock.Foreground" Value="White"/>
                    </Style>
                </Button.Styles>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="⏪ Replay last 30s" Command="{Binding ReplayLast30Command}" IsEnabled="{Binding IsMonitoring}"
                    Background="#243b5a" Foreground="White" Padding="12,8"/>
            <Button Content="⏪ Replay last 60s" Command="{Binding ReplayLast60Command}" IsEnabled="{Binding IsMonitoring}"
                    Background="#243b5a" Foreground="White" Padding="12,8"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#0d0d0d" CornerRadius="6" Padding="12">
            <StackPanel Spacing="8">
                <ToggleButton IsChecked="{Binding IsRecording}" Command="{Binding ToggleRecordCommand}"
                              IsEnabled="{Binding IsMonitoring}" HorizontalAlignment="Left">
                    <ToggleButton.Styles>
                        <Style Selector="ToggleButton">
                            <Setter Property="Background" Value="#2a2a2a"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,8"/>
                        </Style>
                        <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                            <Setter Property="Background" Value="Red"/><Setter Property="TextBlock.Foreground" Value="White"/>
                        </Style>
                        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#3a3a3a"/>
                        </Style>
                        <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#ff5555"/><Setter Property="TextBlock.Foreground" Value="White"/>
                        </Style>
                    </ToggleButton.Styles>
                    <TextBlock Text="⏺ Record to file"/>
                </ToggleButton>
                <Button Content="Open recordings folder" Command="{Binding OpenRecordingsFolderCommand}"
                        Background="#2a2a2a" Foreground="White" Padding="12,6" HorizontalAlignment="Left"/>
                <TextBlock Text="Recordings are saved as WAV files in Documents → IcomRigControl → Recordings."
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="#00ff88" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>
