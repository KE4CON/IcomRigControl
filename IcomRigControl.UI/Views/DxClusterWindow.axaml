<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IcomRigControl.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
        x:Class="IcomRigControl.UI.Views.DxClusterWindow"
        x:DataType="vm:DxClusterViewModel"
        Title="DX Cluster"
        Width="760" Height="600"
        Background="#1a1a1a">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">

        <!-- Connection controls -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Cluster" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox ItemsSource="{Binding AvailableClusters}" SelectedItem="{Binding SelectedCluster}"
                      Width="230" Margin="0,0,10,0"/>
            <TextBlock Text="Host" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Host}" Width="180" Watermark="dxc.nc7j.com" Margin="0,0,10,0"/>
            <TextBlock Text="Port" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Width="110" Margin="0,0,10,0"/>
            <TextBlock Text="Login call" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding LoginCall}" Width="110" Watermark="KE4CON" Margin="0,0,10,0"/>
            <Button Content="Connect" Command="{Binding ConnectCommand}"
                    IsEnabled="{Binding !IsConnected}"
                    Background="#2a2a2a" Foreground="White" Padding="10,6" Margin="0,0,6,0">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#00ff88"/>
                        <Setter Property="TextBlock.Foreground" Value="Black"/>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                    IsEnabled="{Binding IsConnected}"
                    Background="#5a2a2a" Foreground="White" Padding="10,6" Margin="0,0,6,0">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Red"/>
                        <Setter Property="TextBlock.Foreground" Value="White"/>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Content="Clear" Command="{Binding ClearSpotsCommand}"
                    Background="#2a2a2a" Foreground="White" Padding="10,6"/>
        </WrapPanel>

        <!-- Report (post) a spot -->
        <Border Grid.Row="1" Background="#0d0d0d" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Report a spot —" Foreground="#88ccff" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Call" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding SpotCallsign}" Width="110" Watermark="JA1XYZ" Margin="0,0,10,0"/>
                <TextBlock Text="kHz" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding SpotFrequencyKHz}" Width="90" FontFamily="Courier New" Margin="0,0,4,0"/>
                <Button Content="Use radio" Command="{Binding UseRadioFrequencyCommand}"
                        Background="#2a2a2a" Foreground="White" Padding="8,4" Margin="0,0,10,0"/>
                <TextBlock Text="Comment" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding SpotComment}" Width="150" Watermark="FT8, nice sig" Margin="0,0,10,0"/>
                <Button Content="Spot It" Command="{Binding PostSpotCommand}"
                        IsEnabled="{Binding IsConnected}"
                        Background="#2a2a2a" Foreground="White" Padding="10,4">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#00ff88"/>
                            <Setter Property="TextBlock.Foreground" Value="Black"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Click Tune on any spot to QSY the radio to it."
                   Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>

        <!-- Spot list (band map) -->
        <ScrollViewer Grid.Row="3">
            <StackPanel>
                <Grid ColumnDefinitions="60,90,120,*,90,70" Background="#2a2a2a" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="UTC" Foreground="White" FontWeight="Bold" Padding="6,6"/>
                    <TextBlock Grid.Column="1" Text="kHz" Foreground="White" FontWeight="Bold" Padding="6,6"/>
                    <TextBlock Grid.Column="2" Text="DX" Foreground="White" FontWeight="Bold" Padding="6,6"/>
                    <TextBlock Grid.Column="3" Text="Comment" Foreground="White" FontWeight="Bold" Padding="6,6"/>
                    <TextBlock Grid.Column="4" Text="Spotter" Foreground="White" FontWeight="Bold" Padding="6,6"/>
                    <TextBlock Grid.Column="5" Text="" Padding="6,6"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Spots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="60,90,120,*,90,70" Background="#0d0d0d" Margin="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="{Binding TimeUtc}" Foreground="Gray" Padding="6,5" FontFamily="Courier New"/>
                                <TextBlock Grid.Column="1" Text="{Binding FrequencyKHz, StringFormat='{}{0:F1}'}" Foreground="#00ff88" Padding="6,5" FontFamily="Courier New"/>
                                <TextBlock Grid.Column="2" Text="{Binding DxCallsign}" Foreground="White" FontWeight="Bold" Padding="6,5" FontFamily="Courier New"/>
                                <TextBlock Grid.Column="3" Text="{Binding Comment}" Foreground="#88ccff" Padding="6,5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="4" Text="{Binding Spotter}" Foreground="Gray" Padding="6,5" FontFamily="Courier New"/>
                                <Button Grid.Column="5" Content="Tune"
                                        Command="{Binding $parent[ItemsControl].((vm:DxClusterViewModel)DataContext).TuneToSpotCommand}"
                                        CommandParameter="{Binding}"
                                        Background="#2a2a2a" Foreground="White" Margin="4,2" HorizontalAlignment="Stretch">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#00ff88"/>
                                            <Setter Property="TextBlock.Foreground" Value="Black"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
            <TextBlock Text="{Binding Spots.Count, StringFormat='{}{0} spots'}" Foreground="Gray" FontSize="11"/>
            <TextBlock Text="{Binding Status}" Foreground="#00ff88" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
