<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IcomRigControl.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
        x:Class="IcomRigControl.UI.Views.WebRemoteWindow"
        x:DataType="vm:WebRemoteViewModel"
        Title="Phone / Tablet Remote"
        Width="560" Height="480"
        Background="#1a1a1a">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="Control this radio from a phone or tablet browser on the same network."
                       Foreground="#88ccff" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Port:" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Port}" Width="80" IsEnabled="{Binding !IsRunning}"/>
                <TextBlock Text="Access token (optional):" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox Text="{Binding Token}" Width="150" IsEnabled="{Binding !IsRunning}"
                         Watermark="leave blank = none"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding !IsRunning}"
                    Background="#2a2a2a" Foreground="White" Padding="14,6">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#00ff88"/>
                        <Setter Property="TextBlock.Foreground" Value="Black"/>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"
                    Background="#5a2a2a" Foreground="White" Padding="14,6">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Red"/>
                        <Setter Property="TextBlock.Foreground" Value="White"/>
                    </Style>
                </Button.Styles>
            </Button>
        </StackPanel>

        <Border Grid.Row="2" Background="#0d0d0d" CornerRadius="6" Padding="12">
            <StackPanel Spacing="6">
                <TextBlock Text="Open one of these on your phone/tablet:" Foreground="#88ccff" FontWeight="Bold"/>
                <ItemsControl ItemsSource="{Binding Urls}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#00ff88" FontFamily="Courier New"
                                       FontSize="16" Padding="0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Keep this window open while operating remotely — closing it stops the server."
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="Security: this is an unencrypted (HTTP) link. Use it only on a network you trust or over a VPN, and set an access token."
                           Foreground="#d4a017" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#00ff88" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>
