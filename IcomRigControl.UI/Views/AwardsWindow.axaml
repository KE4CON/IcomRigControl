<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IcomRigControl.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="560"
        x:Class="IcomRigControl.UI.Views.AwardsWindow"
        x:DataType="vm:AwardsViewModel"
        Title="Awards"
        Width="440" Height="560"
        Background="#1a1a1a">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,12">
            <TextBlock Text="Award progress" Foreground="#88ccff" FontSize="16" FontWeight="Bold"/>
            <Grid ColumnDefinitions="*,*">
                <Border Grid.Column="0" Background="#0d0d0d" CornerRadius="6" Padding="12" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="{Binding EntityCount}" Foreground="#00ff88" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="DXCC entities" Foreground="Gray"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#0d0d0d" CornerRadius="6" Padding="12" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding GridCount}" Foreground="#00ff88" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="grid squares" Foreground="Gray"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{Binding DxccStatus}" Foreground="#ffcc00" FontWeight="Bold"/>
        </StackPanel>

        <Button Grid.Row="1" Content="Refresh" Command="{Binding RefreshCommand}"
                HorizontalAlignment="Left" Background="#2a2a2a" Foreground="White" Padding="12,6" Margin="0,0,0,8"/>

        <Border Grid.Row="2" Background="#0d0d0d" CornerRadius="6" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entities}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#e0e0e0" Padding="2,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" FontSize="11"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>
