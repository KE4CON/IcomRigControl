<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IcomRigControl.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="640"
        x:Class="IcomRigControl.UI.Views.AprsReceiveWindow"
        x:DataType="vm:AprsReceiveViewModel"
        Title="HF APRS"
        Width="740" Height="640"
        Background="#1a1a1a">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="Start Receive" Command="{Binding StartReceiveCommand}"
                    IsEnabled="{Binding !IsReceiving}"
                    Background="#2a2a2a" Foreground="White" Padding="12,6">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#00ff88"/>
                        <Setter Property="TextBlock.Foreground" Value="Black"/>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Content="Stop" Command="{Binding StopReceiveCommand}"
                    IsEnabled="{Binding IsReceiving}"
                    Background="#5a2a2a" Foreground="White" Padding="12,6">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Red"/>
                        <Setter Property="TextBlock.Foreground" Value="White"/>
                    </Style>
                </Button.Styles>
            </Button>
            <TextBlock Text="HF APRS: 30m 10.1476 MHz / 20m 14.1000 MHz USB (300 baud)."
                       Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Decoded station list -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <Grid ColumnDefinitions="70,120,150,*,80" Background="#2a2a2a" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="Heard" Foreground="White" FontWeight="Bold" Padding="6,6"/>
                    <TextBlock Grid.Column="1" Text="Station" Foreground="White" FontWeight="Bold" Padding="6,6"/>
                    <TextBlock Grid.Column="2" Text="Position" Foreground="White" FontWeight="Bold" Padding="6,6"/>
                    <TextBlock Grid.Column="3" Text="Info / Comment" Foreground="White" FontWeight="Bold" Padding="6,6"/>
                    <TextBlock Grid.Column="4" Text="" Padding="6,6"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Stations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="70,120,150,*,80" Background="#0d0d0d" Margin="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="{Binding LastHeard}" Foreground="Gray" Padding="6,5" FontFamily="Courier New"/>
                                <TextBlock Grid.Column="1" Text="{Binding Callsign}" Foreground="#00ff88" FontWeight="Bold" Padding="6,5" FontFamily="Courier New"/>
                                <TextBlock Grid.Column="2" Text="{Binding Position}" Foreground="#88ccff" Padding="6,5" FontFamily="Courier New"/>
                                <TextBlock Grid.Column="3" Text="{Binding Info}" Foreground="White" Padding="6,5" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="4" Content="aprs.fi"
                                        Command="{Binding $parent[ItemsControl].((vm:AprsReceiveViewModel)DataContext).OpenInAprsFiCommand}"
                                        CommandParameter="{Binding}"
                                        Background="#2a2a2a" Foreground="White" Margin="4,2" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Messages -->
        <Border Grid.Row="2" Background="#0d0d0d" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="Messages" Foreground="#88ccff" FontSize="13" FontWeight="Bold"/>
                <ItemsControl ItemsSource="{Binding Messages}" MaxHeight="120">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Padding="0,2" TextWrapping="Wrap">
                                <Run Text="{Binding Time}" Foreground="Gray" FontFamily="Courier New"/>
                                <Run Text="{Binding From}" Foreground="#00ff88" FontWeight="Bold"/>
                                <Run Text="{Binding Text}" Foreground="White"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding MessageToCall}" Width="110" Watermark="To (call)"/>
                    <TextBox Text="{Binding MessageText}" Width="360" Watermark="Message text"/>
                    <Button Content="Send" Command="{Binding SendMessageCommand}"
                            Background="#2a2a2a" Foreground="White" Padding="12,6">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#00ff88"/>
                                <Setter Property="TextBlock.Foreground" Value="Black"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#00ff88" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>
