<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IcomRigControl.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="520"
        x:Class="IcomRigControl.UI.Views.RttyDecodeWindow"
        x:DataType="vm:RttyDecodeViewModel"
        Title="RTTY Decode"
        Width="680" Height="520"
        Background="#1a1a1a">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="Start" Command="{Binding StartReceiveCommand}"
                    IsEnabled="{Binding !IsReceiving}"
                    Background="#2a2a2a" Foreground="White" Padding="12,6">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#00ff88"/>
                        <Setter Property="TextBlock.Foreground" Value="Black"/>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Content="Stop" Command="{Binding StopReceiveCommand}"
                    IsEnabled="{Binding IsReceiving}"
                    Background="#5a2a2a" Foreground="White" Padding="12,6">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Red"/>
                        <Setter Property="TextBlock.Foreground" Value="White"/>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Content="Clear" Command="{Binding ClearCommand}"
                    Background="#2a2a2a" Foreground="White" Padding="12,6"/>

            <ToggleButton IsChecked="{Binding Reverse}" Content="Reverse"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          ToolTip.Tip="Swap mark/space if the text is garbled (wrong sideband).">
                <ToggleButton.Styles>
                    <Style Selector="ToggleButton">
                        <Setter Property="Background" Value="#2a2a2a"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,6"/>
                    </Style>
                    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                        <Setter Property="Background" Value="#b8860b"/>
                        <Setter Property="TextBlock.Foreground" Value="Black"/>
                    </Style>
                    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#3a3a3a"/>
                    </Style>
                    <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#d4a017"/>
                        <Setter Property="TextBlock.Foreground" Value="Black"/>
                    </Style>
                </ToggleButton.Styles>
            </ToggleButton>

            <TextBlock Text="45.45 baud · 170 Hz shift" Foreground="Gray"
                       VerticalAlignment="Center" FontSize="11" Margin="10,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#0d0d0d" CornerRadius="6" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding DecodedText}" Foreground="#e0e0e0"
                           FontFamily="Courier New" FontSize="18" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="#00ff88" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>
